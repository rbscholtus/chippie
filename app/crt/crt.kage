//kage:unit pixels

package main

// Src0: the phosphor buffer (upscaled picture with afterglow), the same
// size as the area drawn. Coordinates are in source pixels
// (srcPos - imageSrc0Origin()), never imageDstSize(), which is the whole
// destination image (README §3).

var Time float
var Power float // 0 = off, 1 = on; animates the power-on/off collapse
var Tint vec3

func warp(uv vec2) vec2 {
	c := uv*2 - 1
	c *= 1 + 0.06*dot(c.yx, c.yx)
	return c*0.5 + 0.5
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	o := imageSrc0Origin()
	s := imageSrc0Size()
	pos := srcPos - o
	uv := warp(pos / s)
	if uv.x < 0 || uv.x > 1 || uv.y < 0 || uv.y > 1 {
		return vec4(0, 0, 0, 1)
	}

	// Power collapse: squash vertically, then horizontally, into a dot.
	sy := clamp(Power*2, 0.004, 1)
	sx := clamp(Power*2-1, 0.004, 1)
	if Power < 1 {
		uv = (uv-0.5)/vec2(sx, sy) + 0.5
		if uv.x < 0 || uv.x > 1 || uv.y < 0 || uv.y > 1 {
			return vec4(0, 0, 0, 1)
		}
	}

	p := o + uv*s

	// Cheap bloom: centre + 8 neighbours.
	c := imageSrc0At(p).rgb
	b := vec3(0)
	for i := 0; i < 8; i++ {
		a := float(i) * 0.785398
		b += imageSrc0At(p + vec2(cos(a), sin(a))*3).rgb
	}
	c = c + b/8*0.6

	c *= Tint

	// Scanlines and an aperture-grille shadow mask.
	scan := 0.75 + 0.25*sin(pos.y*3.14159*0.66)
	m := mod(pos.x, 3)
	mask := vec3(0.8)
	if m < 1 {
		mask.r = 1.1
	} else if m < 2 {
		mask.g = 1.1
	} else {
		mask.b = 1.1
	}
	c *= scan * mask

	// Vignette, a faint flicker, and the glow of a powered tube.
	d := uv - 0.5
	c *= 1 - dot(d, d)*1.6
	c *= 0.98 + 0.02*sin(Time*60)
	c += vec3(0.03, 0.035, 0.03) * Power

	if Power < 1 {
		c += vec3(1) * (1 - Power) * 0.8
	}
	return vec4(c, 1)
}
