//kage:unit pixels

package main

// Src0: the phosphor buffer (upscaled picture with afterglow), the same
// size as the area drawn. Coordinates are in source pixels
// (srcPos - imageSrc0Origin()), never imageDstSize(), which is the whole
// destination image (DESIGN §3).

var Time float
var Power float    // power-on: 0 = cathode cold, 1 = warmed up
var Collapse float // switch-off: 0 = full picture, 1 = sweep gone
var Spot float     // switch-off: brightness of the hot cathode's spot
var Tint vec3

func warp(uv vec2) vec2 {
	c := uv*2 - 1
	c *= 1 + 0.06*dot(c.yx, c.yx)
	return c*0.5 + 0.5
}

// spot is one gun's soft round spot at the centre, d in tube heights.
func spot(d vec2, r float) float {
	return exp(-dot(d, d) / (r * r))
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	o := imageSrc0Origin()
	s := imageSrc0Size()
	pos := srcPos - o
	tube := warp(pos / s)
	if tube.x < 0 || tube.x > 1 || tube.y < 0 || tube.y > 1 {
		return vec4(0, 0, 0, 1)
	}

	uv := tube
	show := true

	// Power on: the sweep runs at once but the cathode is cold. The picture
	// stays dark for a moment, then fades in at full size: soft at first and
	// a little oversized while the high voltage is still low.
	warm := smoothstep(0.12, 1, Power)
	if Power < 1 {
		uv = (uv-0.5)/(1+0.03*(1-warm)) + 0.5
	}

	// Switch-off: the sweep dies within a few frames, the vertical a little
	// first. The picture shrinks to the centre and brightens, because the
	// same beam current lands on a smaller area.
	gain := 1.0
	if Collapse > 0 {
		sy := mix(1, 0.01, smoothstep(0, 0.8, Collapse))
		sx := mix(1, 0.01, smoothstep(0.15, 1, Collapse))
		uv = (uv-0.5)/vec2(sx, sy) + 0.5
		gain = (1 + 2*Collapse) * (1 - smoothstep(0.7, 1, Collapse))
		show = Collapse < 1
	}
	if uv.x < 0 || uv.x > 1 || uv.y < 0 || uv.y > 1 {
		show = false
	}

	c := vec3(0)
	if show {
		p := o + uv*s

		// Cheap bloom: centre + 8 neighbours, wider as the picture shrinks.
		c = imageSrc0At(p).rgb
		b := vec3(0)
		spread := 3 + 6*Collapse + 4*(1-warm)
		for i := 0; i < 8; i++ {
			a := float(i) * 0.785398
			b += imageSrc0At(p + vec2(cos(a), sin(a))*spread).rgb
		}
		c = mix(b/8, c, warm) + b/8*0.6 // soft while cold
		c *= gain * warm * warm
	}

	// The spot a still-hot cathode leaves once the sweep is gone: soft,
	// a little bigger than the beam, the three guns not quite on top of
	// each other. It fades as the cathode cools.
	if Spot > 0 {
		d := (tube - 0.5) * vec2(s.x/s.y, 1)
		r := 0.004 + 0.004*Spot
		e := vec2(0.0008, 0.0004)
		g := vec3(spot(d-e, r), spot(d, r), spot(d+e, r))
		c += g * Spot * 2.5 * smoothstep(0.5, 1, Collapse)
	}

	c *= Tint

	// Scanlines and an aperture-grille shadow mask.
	scan := 0.75 + 0.25*sin(pos.y*3.14159*0.66)
	m := mod(pos.x, 3)
	mask := vec3(0.8)
	if m < 1 {
		mask.r = 1.1
	} else if m < 2 {
		mask.g = 1.1
	} else {
		mask.b = 1.1
	}
	c *= scan * mask

	// Vignette, a faint flicker, and the glow of a powered tube.
	d := tube - 0.5
	c *= 1 - dot(d, d)*1.6
	c *= 0.98 + 0.02*sin(Time*60)
	c += vec3(0.03, 0.035, 0.03) * Power * (1 - Collapse)

	return vec4(c, 1)
}
